                <table class="w-full text-left text-xs">
                    <thead class="bg-dark-700/50 text-gray-400 sticky top-0">
                        <tr>
                            <th class="p-2.5">Time</th>
                            <th class="p-2.5">Status</th>
                            <th class="p-2.5">Latency</th>
                            <th class="p-2.5">Result</th>
                        </tr>
                    </thead>
                    <tbody id="heartbeats-table-body" class="divide-y divide-dark-700 font-mono">
                        <!-- Injected via JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Frontend Engine Script -->
    <script>
        const API_BASE = '/api/v1';

        document.addEventListener('DOMContentLoaded', () => {
            loadMonitors();
            setInterval(loadMonitors, 5000);
        });

        async function loadMonitors() {
            try {
                const res = await fetch(`${API_BASE}/monitors`);
                const monitors = await res.json();
                renderMonitors(monitors);
            } catch (err) {
                console.error("Failed loading monitors:", err);
            }
        }

        function renderMonitors(monitors) {
            const container = document.getElementById('monitors-container');
            const empty = document.getElementById('empty-state');
            container.innerHTML = '';

            if (monitors.length === 0) {
                empty.classList.remove('hidden');
                return;
            }
            empty.classList.add('hidden');

            monitors.forEach(m => {
                const statusColor = m.status === 'UP' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' :
                                    m.status === 'DOWN' ? 'bg-rose-500/10 text-rose-400 border-rose-500/20' :
                                    'bg-yellow-500/10 text-yellow-400 border-yellow-500/20';

                const card = document.createElement('div');
                card.className = "bg-dark-800 border border-dark-700 hover:border-dark-600 rounded-xl p-5 shadow-lg transition flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs px-2.5 py-1 rounded-full border font-mono font-medium ${statusColor}">
                                <i class="fa-solid fa-circle text-[8px] mr-1.5"></i>${m.status}
                            </span>
                            <span class="text-xs text-gray-500 font-mono">${m.intervalSeconds}s interval</span>
                        </div>
                        <h3 class="text-lg font-bold text-white truncate">${m.name}</h3>
                        <p class="text-xs text-gray-400 font-mono truncate mt-0.5">${m.url}</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-dark-700 flex items-center justify-between text-xs">
                        <span class="text-gray-500">
                            ${m.lastCheckedAt ? new Date(m.lastCheckedAt).toLocaleTimeString() : 'Never checked'}
                        </span>
                        <button onclick="viewMetrics('${m.id}', '${m.name}', '${m.url}')" class="text-emerald-400 hover:text-emerald-300 font-medium">
                            Metrics <i class="fa-solid fa-arrow-right ml-1"></i>
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        async function handleCreateMonitor(e) {
            e.preventDefault();
            const body = {
                name: document.getElementById('m-name').value,
                url: document.getElementById('m-url').value,
                intervalSeconds: parseInt(document.getElementById('m-interval').value),
                timeoutSeconds: 5,
                expectedStatusCode: parseInt(document.getElementById('m-status').value),
                webhookUrl: document.getElementById('m-webhook').value || null
            };

            await fetch(`${API_BASE}/monitors`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            closeCreateModal();
            loadMonitors();
        }

        async function viewMetrics(id, name, url) {
            document.getElementById('metric-monitor-name').textContent = name;
            document.getElementById('metric-monitor-url').textContent = url;
            document.getElementById('metrics-modal').classList.remove('hidden');

            const res = await fetch(`${API_BASE}/monitors/${id}/metrics`);
            const data = await res.json();

            document.getElementById('metric-uptime').textContent = `${data.uptimePercentage.toFixed(1)}%`;
            document.getElementById('metric-latency').textContent = `${data.averageLatencyMs.toFixed(0)} ms`;
            
            const tbody = document.getElementById('heartbeats-table-body');
            tbody.innerHTML = '';

            let latestSSL = 'N/A';
            if (data.recentHeartbeats && data.recentHeartbeats.length > 0) {
                const firstWithSSL = data.recentHeartbeats.find(h => h.sslDaysRemaining !== null && h.sslDaysRemaining !== undefined);
                if (firstWithSSL) latestSSL = `${firstWithSSL.sslDaysRemaining} days`;

                data.recentHeartbeats.forEach(h => {
                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-dark-700/30";
                    tr.innerHTML = `
                        <td class="p-2.5 text-gray-400">${new Date(h.createdAt).toLocaleTimeString()}</td>
                        <td class="p-2.5 text-white">${h.statusCode || 'ERR'}</td>
                        <td class="p-2.5 text-gray-300">${h.latencyMs} ms</td>
                        <td class="p-2.5 ${h.successful ? 'text-emerald-400' : 'text-rose-400'}">
                            ${h.successful ? 'SUCCESS' : (h.errorMessage || 'FAILED')}
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }
            document.getElementById('metric-ssl').textContent = latestSSL;
        }

        function openCreateModal() { document.getElementById('create-modal').classList.remove('hidden'); }
        function closeCreateModal() { document.getElementById('create-modal').classList.add('hidden'); }
        function closeMetricsModal() { document.getElementById('metrics-modal').classList.add('hidden'); }
    </script>
</body>
</html>
